{
  "name": "@doxvelt/engine",
  "version": "0.2.0-alpha.1",
  "private": true,
  "packageManager": "bun@1.3.13",
  "type": "module",
  "bin": {
    "doxvelt": "./src/cli/index.ts"
  },
  "scripts": {
    "check": "node ./scripts/cargo.mjs build --locked && node ./scripts/cargo.mjs test --locked && node ./scripts/check-native-boundary.mjs && node ./scripts/lint.ts && tsc --noEmit && node --test tests/*.test.ts && node ./scripts/smoke.ts",
    "api": "node ./src/local-api/index.ts",
    "dev": "node ./scripts/dev.js",
    "start": "node ./scripts/dev.js",
    "doxvelt": "node ./src/cli/index.ts",
    "lint": "node ./scripts/lint.ts",
    "smoke": "node ./scripts/smoke.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "ui": "node ./scripts/dev.js",
    "ui:build": "node ./scripts/check-dsh.mjs",
    "desktop:package": "node ./scripts/package-dsh.mjs",
    "desktop:verify": "node ./scripts/test-dsh-package.mjs",
    "api:build": "node ./scripts/cargo.mjs build --locked",
    "api:test": "node ./scripts/cargo.mjs test --locked",
    "inference:setup": "node ./scripts/setup-inference.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "ai": "^6.0.183"
  }
}
