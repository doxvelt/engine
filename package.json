{
  "name": "@doxvelt/engine",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "type": "module",
  "bin": {
    "doxvelt": "./src/cli/index.ts"
  },
  "scripts": {
    "check": "node ./scripts/lint.ts && tsc --noEmit && node --test test/*.test.ts && node ./scripts/smoke.ts",
    "doxvelt": "node ./src/cli/index.ts",
    "lint": "node ./scripts/lint.ts",
    "smoke": "node ./scripts/smoke.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.47",
    "ai": "^6.0.183"
  }
}
