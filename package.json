{
  "name": "@doxvelt/engine",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "type": "module",
  "bin": {
    "doxvelt": "./src/cli/index.ts"
  },
  "scripts": {
    "check": "node ./scripts/lint.ts && tsc --noEmit && node --test tests/*.test.ts && node ./scripts/smoke.ts",
    "api": "node ./src/local-api/index.ts",
    "doxvelt": "node ./src/cli/index.ts",
    "lint": "node ./scripts/lint.ts",
    "smoke": "node ./scripts/smoke.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "ui": "nuxt dev src/local-ui",
    "ui:build": "nuxt build src/local-ui"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.109",
    "@nuxt/ui": "^4.8.0",
    "@types/node": "^24.10.1",
    "nuxt": "^4.4.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.47",
    "ai": "^6.0.183"
  }
}
